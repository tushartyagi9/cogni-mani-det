# ─────────────────────────────────────────────────────────────────────────────
# CogniGuard – Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI – used by the Express server to power analysis
GROQ_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Firecrawl – used by the Express server to extract webpage content from URLs
FIRECRAWL_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Supabase – used by the Express server for persistent history storage
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxx...
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxx...

# Express server port (default 3001)
PORT=3001

# Allowed CORS origin – set to your frontend URL in production
ALLOWED_ORIGIN=http://localhost:5173

# ─── Frontend (Vite) ───────────────────────────────────────────────────────
# In development: leave empty – Vite dev-proxy forwards /api/* to localhost:3001
# In production:  set to your deployed API URL, e.g. https://api.cogniguard.app
VITE_API_BASE_URL=
